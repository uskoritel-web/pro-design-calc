# Секреты приложения (на сервере кладём в app/.env, в git НЕ коммитим).
# DB-реквизиты и APP_PORT/APP_IP NetAngels пробрасывает автоматически.

# Пароль команды для входа в калькулятор
APP_PASSWORD=change-me

# Секрет для подписи сессии (случайная длинная строка)
AUTH_SECRET=change-me-to-a-long-random-string

# Публичный адрес сайта (для ссылок в Telegram)
SITE_URL=https://kalkulator-mebeli.na4u.ru

# Telegram-уведомления (необязательно; без них просто не отправляются)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
